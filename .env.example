# --- Database ---
DB_USER=xxx
DB_PASS=xxx
DB_HOST=localhost
DB_PORT=5433
DB_NAME=xxx

LOG_LEVEL=INFO
# json (default, untuk agregator log) atau text (untuk dibaca manusia)
LOG_FORMAT=json
LOG_FILE=logs/api.log

# --- RabbitMQ ---
RABBITMQ_HOST=xxx
RABBITMQ_USER=xxx
RABBITMQ_PASSWORD=xxx

# --- Auth user dashboard (JWT) ---
# WAJIB diisi, aplikasi menolak start tanpa ini.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS untuk frontend terpisah ---
# Daftar origin dipisah koma. Kosongkan kalau belum ada frontend.
# Jangan pakai "*" — itu mengizinkan situs mana pun memanggil API ini.
CORS_ORIGINS=http://localhost:3000
